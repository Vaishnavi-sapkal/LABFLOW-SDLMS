# A MongoDB Atlas connection URI without a database path is recommended. The
# supervisor creates the existing per-service databases listed in the guide.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=generate-a-long-random-secret
INTERNAL_SERVICE_SECRET=generate-a-separate-long-random-secret
JWT_EXPIRES_IN=1d
FRONTEND_URL=https://your-frontend.example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=LabFlow <your_email@gmail.com>
SMTP_SECURE=false
UPI_ID=your_upi_id
UPI_PAYEE_NAME=LabFlow Diagnostics

# Optional: override an individual service database URI instead of deriving it
# from MONGODB_URI. For example: AUTH_SERVICE_MONGODB_URI=mongodb+srv://...
