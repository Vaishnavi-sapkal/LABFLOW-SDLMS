{
    "exclude": [
                    "src/**/*.spec.ts"
                ],
    "include":  [
                    "src/**/*.ts",
                    "scripts/**/*.ts"
                ],
    "compilerOptions":  {
                            "allowSyntheticDefaultImports":  true,
                            "target":  "ES2021",
                            "baseUrl":  "./",
                            "strict":  true,
                            "declaration":  true,
                            "module":  "commonjs",
                            "incremental":  true,
                            "sourceMap":  true,
                            "skipLibCheck":  true,
                            "outDir":  "./dist",
                            "emitDecoratorMetadata":  true,
                            "removeComments":  true,
                            "experimentalDecorators":  true
                        }
}
